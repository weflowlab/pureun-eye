# Payload CMS
PAYLOAD_SECRET=change-me-to-a-long-random-string
# 개발: 로컬 SQLite 파일 / 운영: Neon 등 Postgres 주소 (postgres:// 로 시작하면 Postgres 어댑터)
DATABASE_URI=file:./payload.db
# DATABASE_AUTH_TOKEN=   # Turso(libSQL) 사용 시
PREVIEW_SECRET=change-me-preview-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# BLOB_READ_WRITE_TOKEN=   # 운영 이미지 저장소 (Vercel Blob). 없으면 public/media 에 저장
# SEED_ADMIN_EMAIL= / SEED_ADMIN_PASSWORD=   # npm run seed 가 만드는 첫 관리자 계정
